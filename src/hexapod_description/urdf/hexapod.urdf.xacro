<?xml version="1.0"?>
<!-- 18-DOF hexapod (RookiDroid Mochi, MG92B). Every number comes from config/robot_parameters.yaml.
     Each leg frame is rotated about z from base_link, so x points outward and z up on all six legs.
     Joint axes are the same in every leg frame: coxa +z, femur -y (+ lifts the foot), tibia -y (+ swings the foot out).
     Left legs mirror only the bodies (meshes, centre of mass, inertia, collision), through sign = -1. -->
<robot name="hexapod" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="p" value="${xacro.load_yaml('$(find hexapod_description)/config/robot_parameters.yaml')}"/>
  <xacro:property name="mesh_dir" value="package://hexapod_description/meshes"/>

  <material name="body_red"><color rgba="0.79 0.42 0.42 1"/></material>
  <material name="coxa_teal"><color rgba="0.44 0.79 0.77 1"/></material>
  <material name="femur_green"><color rgba="0.50 0.82 0.50 1"/></material>
  <material name="tibia_blue"><color rgba="0.42 0.42 0.79 1"/></material>
  <material name="foot_black"><color rgba="0.15 0.15 0.15 1"/></material>

  <xacro:macro name="inertial_block" params="d sign">
    <inertial>
      <origin xyz="${d['com'][0]} ${d['com'][1] * sign} ${d['com'][2]}" rpy="0 0 0"/>
      <mass value="${d['mass']}"/>
      <inertia ixx="${d['inertia']['ixx']}" ixy="${d['inertia']['ixy'] * sign}" ixz="${d['inertia']['ixz']}"
               iyy="${d['inertia']['iyy']}" iyz="${d['inertia']['iyz'] * sign}" izz="${d['inertia']['izz']}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_collision" params="s sign">
    <collision>
      <origin xyz="${s['xyz'][0]} ${s['xyz'][1] * sign} ${s['xyz'][2]}" rpy="0 0 0"/>
      <geometry><box size="${s['size'][0]} ${s['size'][1]} ${s['size'][2]}"/></geometry>
    </collision>
  </xacro:macro>

  <!-- Body arm collision box, rotated out to the leg's yaw -->
  <xacro:macro name="arm_collision" params="leg_index">
    <xacro:property name="yaw" value="${p['legs'][leg_index]['yaw']}"/>
    <xacro:property name="a" value="${p['collision']['base']['arm']}"/>
    <collision>
      <origin xyz="${a['radial_center'] * cos(yaw)} ${a['radial_center'] * sin(yaw)} ${a['z']}" rpy="0 0 ${yaw}"/>
      <geometry><box size="${a['size'][0]} ${a['size'][1]} ${a['size'][2]}"/></geometry>
    </collision>
  </xacro:macro>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/base_link.stl"/></geometry>
      <material name="body_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${p['collision']['base']['hub']['z']}" rpy="0 0 0"/>
      <geometry><cylinder radius="${p['collision']['base']['hub']['radius']}" length="${p['collision']['base']['hub']['length']}"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 ${p['collision']['base']['dome']['z']}" rpy="0 0 0"/>
      <geometry><cylinder radius="${p['collision']['base']['dome']['radius']}" length="${p['collision']['base']['dome']['length']}"/></geometry>
    </collision>
    <xacro:arm_collision leg_index="0"/>
    <xacro:arm_collision leg_index="1"/>
    <xacro:arm_collision leg_index="2"/>
    <xacro:arm_collision leg_index="3"/>
    <xacro:arm_collision leg_index="4"/>
    <xacro:arm_collision leg_index="5"/>
    <xacro:inertial_block d="${p['links']['base']}" sign="1"/>
  </link>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${p['imu']['xyz'][0]} ${p['imu']['xyz'][1]} ${p['imu']['xyz'][2]}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="leg_joint" params="name parent child xyz cfg">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="${cfg['axis'][0]} ${cfg['axis'][1]} ${cfg['axis'][2]}"/>
      <limit lower="${cfg['lower']}" upper="${cfg['upper']}" effort="${cfg['effort']}" velocity="${cfg['velocity']}"/>
    </joint>
  </xacro:macro>

  <!-- One leg. Reused six times; side selects the mirrored meshes and sign flips lateral values. -->
  <xacro:macro name="leg" params="id">
    <xacro:property name="cfg" value="${p['legs'][id - 1]}"/>
    <xacro:property name="side" value="${cfg['side']}"/>
    <xacro:property name="sign" value="${cfg['mirror']}"/>
    <xacro:property name="geo" value="${p['leg_geometry']}"/>
    <xacro:property name="col" value="${p['collision']}"/>

    <joint name="leg_${id}_coxa" type="revolute">
      <parent link="base_link"/>
      <child link="leg_${id}_coxa_link"/>
      <origin xyz="${cfg['x']} ${cfg['y']} ${p['body']['hip_z']}" rpy="0 0 ${cfg['yaw']}"/>
      <axis xyz="${p['joints']['coxa']['axis'][0]} ${p['joints']['coxa']['axis'][1]} ${p['joints']['coxa']['axis'][2]}"/>
      <limit lower="${p['joints']['coxa']['lower']}" upper="${p['joints']['coxa']['upper']}"
             effort="${p['joints']['coxa']['effort']}" velocity="${p['joints']['coxa']['velocity']}"/>
    </joint>

    <link name="leg_${id}_coxa_link">
      <visual>
        <geometry><mesh filename="${mesh_dir}/coxa_${side}.stl"/></geometry>
        <material name="coxa_teal"/>
      </visual>
      <xacro:box_collision s="${col['coxa']['plate_top']}" sign="1"/>
      <xacro:box_collision s="${col['coxa']['plate_bottom']}" sign="1"/>
      <xacro:box_collision s="${col['coxa']['plate_horn_side']}" sign="${sign}"/>
      <xacro:box_collision s="${col['coxa']['plate_pin_side']}" sign="${sign}"/>
      <collision>
        <origin xyz="${col['coxa']['cross']['x']} 0 0" rpy="0 ${pi / 2} 0"/>
        <geometry><cylinder radius="${col['coxa']['cross']['radius']}" length="${col['coxa']['cross']['length']}"/></geometry>
      </collision>
      <xacro:inertial_block d="${p['links']['coxa']}" sign="${sign}"/>
    </link>

    <xacro:leg_joint name="leg_${id}_femur" parent="leg_${id}_coxa_link" child="leg_${id}_femur_link"
                     xyz="${geo['coxa_length']} 0 0" cfg="${p['joints']['femur']}"/>

    <link name="leg_${id}_femur_link">
      <visual>
        <geometry><mesh filename="${mesh_dir}/femur_${side}.stl"/></geometry>
        <material name="femur_green"/>
      </visual>
      <xacro:box_collision s="${col['femur']['block']}" sign="${sign}"/>
      <xacro:inertial_block d="${p['links']['femur']}" sign="${sign}"/>
    </link>

    <xacro:leg_joint name="leg_${id}_tibia" parent="leg_${id}_femur_link" child="leg_${id}_tibia_link"
                     xyz="${geo['femur_length']} 0 0" cfg="${p['joints']['tibia']}"/>

    <link name="leg_${id}_tibia_link">
      <visual>
        <geometry><mesh filename="${mesh_dir}/tibia_${side}.stl"/></geometry>
        <material name="tibia_blue"/>
      </visual>
      <xacro:box_collision s="${col['tibia']['plate_horn_side']}" sign="${sign}"/>
      <xacro:box_collision s="${col['tibia']['plate_pin_side']}" sign="${sign}"/>
      <xacro:box_collision s="${col['tibia']['ground_upper']}" sign="${sign}"/>
      <xacro:box_collision s="${col['tibia']['ground_lower']}" sign="${sign}"/>
      <xacro:inertial_block d="${p['links']['tibia']}" sign="${sign}"/>
    </link>

    <joint name="leg_${id}_foot_joint" type="fixed">
      <parent link="leg_${id}_tibia_link"/>
      <child link="leg_${id}_foot_link"/>
      <origin xyz="0 0 ${-geo['tibia_length']}" rpy="0 0 0"/>
    </joint>

    <link name="leg_${id}_foot_link">
      <visual>
        <geometry><mesh filename="${mesh_dir}/foot_${side}.stl"/></geometry>
        <material name="foot_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${col['foot']['z']}" rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${col['foot']['radius']}" length="${col['foot']['length']}"/></geometry>
      </collision>
      <xacro:inertial_block d="${p['links']['foot']}" sign="${sign}"/>
    </link>
  </xacro:macro>

  <xacro:leg id="1"/>
  <xacro:leg id="2"/>
  <xacro:leg id="3"/>
  <xacro:leg id="4"/>
  <xacro:leg id="5"/>
  <xacro:leg id="6"/>
</robot>
